<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The morning heartbeat: one engine pass at 06:00, so a vault that
     was quiet overnight still gets scanned and the day's date-based
     views (`chickenskratch today`) are computed against the new date. The
     engine's memo makes it nearly free when nothing changed.
     Install: setup.sh fills __REPO__/__VAULT__/__UV__/__PATH__ and
     loads it. By hand, substitute all four, then
       cp config/launchd/com.chickenskratch.heartbeat.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.chickenskratch.heartbeat.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.chickenskratch.heartbeat</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string>
    <string>run</string>
    <string>chickenskratch-watch</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>__REPO__/data/logs/heartbeat.log</string>
  <key>StandardErrorPath</key><string>__REPO__/data/logs/heartbeat.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__PATH__</string>
    <key>CHICKENSKRATCH_VAULT_PATH</key><string>__VAULT__</string>
  </dict>
</dict>
</plist>
